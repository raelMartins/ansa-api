NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local default matches docker-compose.yml
DATABASE_URL=postgres://ansa:ansa@localhost:5432/ansa_dev

# Generate long random strings (32+ chars). Never commit real secrets.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated browser origins. Native apps do not use CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
