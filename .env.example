NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Local default matches docker-compose.yml
DATABASE_URL=postgres://ansa:ansa@localhost:5432/ansa_dev

# Generate long random strings (32+ chars). Never commit real secrets.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated browser origins. Native apps do not use CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Shop web origin used in share links and payment callbacks
PUBLIC_APP_URL=http://localhost:3000

# mock (default) | flutterwave — flutterwave requires FLUTTERWAVE_SECRET_KEY
PAYMENT_PROVIDER=mock
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx

# local_disk (default) | cloudinary — cloudinary requires CLOUDINARY_* (OPEN: tier limits)
MEDIA_PROVIDER=local_disk
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
